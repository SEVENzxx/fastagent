# 模板文件：复制为 .env 后根据实际情况修改
# ===== 应用 =====
APP_NAME=fastagent
APP_ENV=development
APP_DEBUG=true

# ===== Server =====
HOST=0.0.0.0
PORT=8000

# ===== Database (PostgreSQL with pgvector) =====
POSTGRES_USER=fastagent
POSTGRES_PASSWORD=fastagent
POSTGRES_DB=fastagent
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://fastagent:fastagent@localhost:5432/fastagent
DATABASE_URL_SYNC=postgresql://fastagent:fastagent@localhost:5432/fastagent

# ===== Redis =====
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# ===== AI model services（本地 Ollama）=====
# 通用 LLM 任务（意图精判、回复生成、RAG 合成、Agent）走 Ollama OpenAI 兼容接口。
# AI_LLM_PROVIDER=http 时调用 {AI_LLM_BASE_URL}/v1/chat/completions
# 如果要用云端模型，改 AI_LLM_PROVIDER=litellm：
# OpenAI:   AI_LLM_MODEL=openai/gpt-4o-mini
# DeepSeek: AI_LLM_MODEL=deepseek/deepseek-chat
AI_LLM_PROVIDER=http
AI_LLM_API_KEY=
AI_LLM_BASE_URL=http://localhost:11434
AI_LLM_MODEL=qwen2.5-1.5b-commerce
AI_LLM_TIMEOUT_SECONDS=30
AI_LLM_MAX_TOKENS=256

# Ollama 原生接口（电商路由分类 /api/generate）
AI_LOCAL_LLM_ENABLED=true
AI_LOCAL_LLM_BASE_URL=http://localhost:11434
AI_LOCAL_LLM_MODEL=qwen2.5-1.5b-commerce
AI_LOCAL_LLM_TIMEOUT_SECONDS=8.0
AI_LOCAL_LLM_MAX_TOKENS=150
AI_EMBEDDING_ENABLED=true
AI_EMBEDDING_BASE_URL=http://localhost:8001
AI_EMBEDDING_TIMEOUT_SECONDS=5
AI_EMBEDDING_DIMENSION=512
QDRANT_ENABLED=true
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_TIMEOUT_SECONDS=5
QDRANT_DISTANCE=Cosine
QDRANT_COLLECTION_INTENT_SAMPLES=fastagent_intent_samples
QDRANT_COLLECTION_KNOWLEDGE_CHUNKS=fastagent_knowledge_chunks
QDRANT_COLLECTION_QA_PAIRS=fastagent_qa_pairs
QDRANT_COLLECTION_PRODUCTS=fastagent_products
QDRANT_COLLECTION_MARKETING_DOCS=fastagent_marketing_documents
QDRANT_COLLECTION_IMAGES=fastagent_images

# ===== RAG / Knowledge Base =====
# QA 标准问答使用高阈值直出；知识片段和商品向量使用中低阈值召回后交给 RAG/LLM 判断。
AI_RERANKER_PROVIDER=http
AI_RERANKER_BASE_URL=http://localhost:8002/rerank
AI_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
AI_RERANKER_ENABLED=true
AI_RERANKER_TIMEOUT_SECONDS=10
AI_KNOWLEDGE_TOP_K=20
AI_KNOWLEDGE_MIN_SCORE=0.50
AI_KNOWLEDGE_RERANK_TOP_K=5
AI_KNOWLEDGE_CHUNK_SIZE=500
AI_KNOWLEDGE_CHUNK_OVERLAP=100
AI_KNOWLEDGE_MIN_CHUNK_SIZE=100
AI_KNOWLEDGE_BATCH_SIZE=32
AI_KNOWLEDGE_QA_MIN_SCORE=0.85
AI_KNOWLEDGE_QA_TOP_K=3
AI_GENERAL_REPLY_RAG_TOP_K=5
AI_GENERAL_REPLY_RAG_MIN_SCORE=0.50
AI_PRODUCT_VECTOR_TOP_K=10
AI_PRODUCT_VECTOR_MIN_SCORE=0.45
AI_PRODUCT_CONSULT_KNOWLEDGE_TOP_K=5
AI_PRODUCT_CONSULT_KNOWLEDGE_MIN_SCORE=0.45
AI_PRODUCT_CONSULT_USE_LLM_WHEN_HAS_CONTEXT=true

# ===== Agent runtime =====
# 模型参数由租户 LLMConfig 接管，以下仅控制 Agent 行为开关：
AI_AGENT_ENABLED=true
AI_AGENT_MAX_TOOL_CALLS=3
AI_AGENT_TIMEOUT_SECONDS=30
AI_AGENT_RECENT_MESSAGE_LIMIT=20
AI_AGENT_ENABLE_HITL=false
AI_AGENT_ENABLE_MCP_STUBS=true

# ===== Security =====
SECRET_KEY=change-me-to-a-random-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ===== CORS =====
CORS_ORIGINS=["http://localhost:5173"]
