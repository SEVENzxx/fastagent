# 模板文件：复制为 .env 后根据实际情况修改
# ===== 应用 =====
APP_NAME=fastagent
APP_ENV=development
APP_DEBUG=true

# ===== Server =====
HOST=0.0.0.0
PORT=8000

# ===== Database (PostgreSQL with pgvector) =====
POSTGRES_USER=fastagent
POSTGRES_PASSWORD=fastagent
POSTGRES_DB=fastagent
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://fastagent:fastagent@localhost:5432/fastagent
DATABASE_URL_SYNC=postgresql://fastagent:fastagent@localhost:5432/fastagent

# ===== Redis =====
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# ===== AI model services =====
# AI_LLM_PROVIDER=http 时走自部署 8003 服务：
#   complete -> {AI_LLM_BASE_URL}/v1/chat/completions
#   chat     -> {AI_LLM_BASE_URL}/chat
# AI_LLM_PROVIDER=litellm 时走大厂 API：
# 示例：
# OpenAI:   AI_LLM_MODEL=openai/gpt-4o-mini
# DeepSeek: AI_LLM_MODEL=deepseek/deepseek-chat
# 通义千问 OpenAI 兼容接口: AI_LLM_MODEL=openai/qwen-plus, AI_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_LLM_PROVIDER=http
AI_LLM_API_KEY=
AI_LLM_BASE_URL=http://localhost:8003
AI_LLM_MODEL=qwen2.5-0.5b-local
AI_INTENT_JUDGE_MODEL=
AI_GENERAL_REPLY_MODEL=
AI_LLM_TIMEOUT_SECONDS=30
AI_LLM_MAX_TOKENS=128
AI_INTENT_JUDGE_MAX_TOKENS=64
AI_GENERAL_REPLY_MAX_TOKENS=128
AI_INTENT_JUDGE_TEMPERATURE=0
AI_GENERAL_REPLY_TEMPERATURE=0.2
AI_EMBEDDING_ENABLED=true
AI_EMBEDDING_BASE_URL=http://localhost:8001
AI_EMBEDDING_TIMEOUT_SECONDS=5

# ===== Agent runtime =====
# AI_AGENT_MODEL 为空时复用 AI_LLM_MODEL。
# MAX_TOOL_CALLS 防止 LangGraph 工具循环失控；TIMEOUT 控制单轮 Agent 总耗时。
AI_AGENT_ENABLED=true
AI_AGENT_MODEL=
AI_AGENT_MAX_TOKENS=512
AI_AGENT_TEMPERATURE=0.2
AI_AGENT_MAX_TOOL_CALLS=3
AI_AGENT_TIMEOUT_SECONDS=30
AI_AGENT_RECENT_MESSAGE_LIMIT=20
AI_AGENT_ENABLE_HITL=false
AI_AGENT_ENABLE_MCP_STUBS=true

# ===== Security =====
SECRET_KEY=change-me-to-a-random-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ===== CORS =====
CORS_ORIGINS=["http://localhost:5173"]
