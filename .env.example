# 模板文件：复制为 .env 后根据实际情况修改
# ===== 应用 =====
APP_NAME=fastagent
APP_ENV=development
APP_DEBUG=true

# ===== Server =====
HOST=0.0.0.0
PORT=8000

# ===== Database (PostgreSQL with pgvector) =====
POSTGRES_USER=fastagent
POSTGRES_PASSWORD=fastagent
POSTGRES_DB=fastagent
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://fastagent:fastagent@localhost:5432/fastagent
DATABASE_URL_SYNC=postgresql://fastagent:fastagent@localhost:5432/fastagent

# ===== Redis =====
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# ===== Security =====
SECRET_KEY=change-me-to-a-random-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ===== CORS =====
CORS_ORIGINS=["http://localhost:5173"]
